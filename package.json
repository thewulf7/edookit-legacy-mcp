{
  "name": "edookit-legacy-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Edookit parent/student portal (web scraping)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "edookit-legacy-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "playwright install chromium --with-deps || true"
  },
  "keywords": ["mcp", "edookit", "school", "portal", "playwright"],
  "author": "thewulf7",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
